APP_NAME=Zirak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=prs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. On cPanel use MySQL:
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cpaneluser_zirak
# DB_USERNAME=cpaneluser_zirak
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Zirak ---
ZIRAK_DEFAULT_LOCALE=prs
ZIRAK_PASS_MARK=70

# SMS for login codes: "log" writes codes to storage/logs/laravel.log (development only).
SMS_DRIVER=log

# HesabPay: fake (local demo page) | sandbox | live
HESABPAY_DRIVER=fake
HESABPAY_API_KEY=
# HESABPAY_BASE_URL=https://api-sandbox.hesab.com

# Bunny Stream video library ID (lessons embed videos by video ID)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_READ_ONLY_KEY=

# AI tutor: fake (demo answers, local only) | anthropic (Claude API)
AI_TUTOR_ENABLED=true
AI_TUTOR_DRIVER=fake
ANTHROPIC_API_KEY=
AI_TUTOR_MODEL=claude-haiku-5-5
AI_TUTOR_DAILY_LIMIT=20

# HesabPay, Bunny, AI tutor and Telegram keys can be set in Admin → Settings instead
# (stored encrypted; a value saved there wins over this file).

# Telegram login + bot (from @BotFather). Leave empty to hide Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; run `php artisan zirak:telegram-setup` after setting these.
TELEGRAM_WEBHOOK_SECRET=

# Teacher's default share of each sale, in percent (can be set per course in admin).
ZIRAK_TEACHER_SHARE=70
